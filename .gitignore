/target

# The reference server under bench/ is its own cargo project, so its build
# directories are not covered by the anchored rule above. `target-mi` is the
# same crate built against mimalloc, to hold the allocator constant when
# comparing memory.
/bench/tokio-h2/target/
/bench/tokio-h2/target-mi/
/bench/tonic-grpc/target/

# h2load output and RSS samples: regenerated by every run of bench/run.sh.
/bench/results*/

# The libh2o reference server, built by bench/h2o/build.sh.
/bench/h2o/server
